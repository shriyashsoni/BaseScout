# ─────────────────────────────────────────────────────────────
# BaseScout configuration
# Copy this file to `.env` and fill in your key.
# ─────────────────────────────────────────────────────────────

# REQUIRED for the AI analysis layer.
# Get one at https://console.anthropic.com/  ->  Settings -> API Keys
ANTHROPIC_API_KEY=

# OPTIONAL. Model to use. Defaults to the most capable Claude model.
BASESCOUT_MODEL=claude-opus-4-8

# OPTIONAL. Base mainnet JSON-RPC endpoint.
# The public endpoint works out of the box; swap in an Alchemy/Infura URL
# if you hit rate limits.
BASE_RPC_URL=https://mainnet.base.org
